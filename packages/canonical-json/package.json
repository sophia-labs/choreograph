{
	"name": "@sophia-labs/canonical-json",
	"version": "0.1.0",
	"description": "Sophia canonical JSON and digest contract",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./golden-vectors.json": "./golden-vectors.json"
	},
	"files": [
		"dist",
		"golden-vectors.json",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "tsx --test test/*.test.ts"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^24.3.0",
		"tsx": "^4.20.3",
		"typescript": "^5.9.2"
	}
}
