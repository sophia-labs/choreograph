# Choreograph orchestrator — example environment.
# Only variables the code actually reads are listed. The gen-2 (Garden gateway +
# Cognito) deploy needs the GATEWAY/SERVICE/COGNITO block; the MNEMOSYNE_API_*
# entries near the bottom are platform-1-era affordances kept as fallbacks.
#
# ── Local VM quick start (zero-cloud) ──────────────────────────────────────
# For `pnpm dev:vm` / `pnpm test:vm` (see CONTRIBUTING.md) you need NOTHING here:
# mock models ("mock:done" / "mock:text") bypass OPENROUTER_API_KEY, and
# sandboxes default to a disabled Mnemosyne transport, so no MNEMOSYNE_* gateway
# or COGNITO_* values are required to boot or to run mock agents (agent runs
# need an agent body: see SOPHIA_AGENT_RUNTIME_ENTRYPOINT below). The VM seeds
# /etc/choreograph/dev.env from scripts/vm/dev.env.example — set keys there (or
# in this file) only for the real-LLM or hosted-knowledge-graph paths.

PORT=3456
# Address the HTTP edge binds (default 0.0.0.0). A local package under gardend sets 127.0.0.1.
CHOREOGRAPH_BIND_HOST=
DATA_DIR=src/.data
# A workspace chat session's cost budget in dollars (default 1).
CHOREOGRAPH_WORKSPACE_CHAT_MAX_COST_USD=
WORKSPACE_ROOT=
WORKER_SCRIPT=
# The agent body: packages/agent-body/src/main.ts from source (gardend's service runs body/body.mjs).
SOPHIA_AGENT_RUNTIME_ENTRYPOINT=
# A local Choreograph: agent steps that name no runtime or identity get the installed body and a standalone one,
# and the workspace chat's tools on their graph. gardend's service sets both to 1.
CHOREOGRAPH_LOCAL_AGENT_DEFAULTS=
WORKFLOW_DYNAMIC_SOURCE=

# ── Gen-2 Mnemosyne: Garden gateway + Cognito ──────────────────────────────
MNEMOSYNE_GRAPH_ID=
# Garden gateway base URL the orchestrator proxies tool/session traffic through.
MNEMOSYNE_GATEWAY_BASE_URL=
# Service token presented as x-internal-service for gateway/cell calls.
MNEMOSYNE_SERVICE_TOKEN=
# Cognito user pool — delegated ID tokens are verified locally against its JWKS
# (no /profile/me round-trip). Set this for a pure gen-2 deploy.
COGNITO_USER_POOL_ID=
# Cognito app client id = the token audience checked during ID-token verify.
COGNITO_CLIENT_ID=

# ── Workflow emporium ingest ───────────────────────────────────────────────
# Where completed run artifacts are POSTed for emporium ingest, plus its bearer.
WORKFLOW_EMPORIUM_INGEST_URL=
WORKFLOW_EMPORIUM_INGEST_BEARER=

# ── Mnemosyne tool surface / runtime knobs ─────────────────────────────────
MNEMOSYNE_RUNTIME=choreograph
MNEMOSYNE_TOOL_PROFILE=chat
MNEMOSYNE_REQUEST_TIMEOUT_MS=60000
# Internal-service minting secret expected on x-internal-service inbound auth.
MNEMOSYNE_INTERNAL_SERVICE_SECRET=

# ── platform-1-era affordances (kept as fallbacks/overrides) ───────────────
# Legacy hosted control-plane base; only used for the /profile/me identity
# fallback when COGNITO_USER_POOL_ID is unset. A gen-2 deploy can leave it blank.
MNEMOSYNE_API_BASE_URL=
# Legacy hosted bearer + explicit MCP endpoint override (platform-1 era).
MNEMOSYNE_API_TOKEN=
MNEMOSYNE_MCP_URL=
MNEMOSYNE_ALLOW_GLOBAL_TOKEN_FALLBACK=0

# ── OpenRouter (orchestrator-only; never enters the sandbox) ────────────────
OPENROUTER_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=Choreograph Sandbox
# Live catalog: stale-while-revalidate on access + one host-side refresh timer.
# The last-known-good snapshot defaults to DATA_DIR/openrouter-model-catalog.json.
OPENROUTER_CATALOG_TTL_MS=900000
OPENROUTER_CATALOG_REFRESH_MS=900000

# ── Experimental personal Agent evolution (owner-scoped, bwrap only) ──────
# Disabled unless AGENT_EVOLUTION_REPOSITORY_PATH is non-empty. This must be a
# credential-free local Git source authority; Choreograph clones exact detached
# candidates and never mounts the repository itself into Prime.
AGENT_EVOLUTION_REPOSITORY_PATH=
AGENT_EVOLUTION_REPOSITORY_ID=prime-agent
AGENT_EVOLUTION_BASE_REVISION=HEAD
AGENT_EVOLUTION_ALLOWED_PATHS=extension
AGENT_EVOLUTION_EXTENSION_ROOT=extension
AGENT_EVOLUTION_MAX_WORKSPACE_BYTES=268435456
AGENT_EVOLUTION_WORKSPACE_LEASE_MS=900000
# The independent evaluator requires one manifest skill and at least one exact
# input/output fixture. Example only; replace all three values for your skill.
AGENT_EVOLUTION_SKILL_NAME=
AGENT_EVOLUTION_FIXTURES_JSON=
# Comma-separated host capability names an extension may declare. Empty is the
# recommended starting posture. It never grants credentials or network access.
AGENT_EVOLUTION_ALLOWED_CAPABILITIES=
# Optional S3 snapshot URL for the evolution authority DB. Local runs leave it blank.
AGENT_EVOLUTION_S3_URL=
