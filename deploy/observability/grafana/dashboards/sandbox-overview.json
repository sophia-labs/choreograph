{
  "uid": "sandbox-overview",
  "title": "Sandbox Lifecycle Overview",
  "tags": ["sandbox-mgmt"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "template",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "query": "label_values(sandbox_mgmt_spawns_total, template)",
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "title": "Active Sandboxes",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sum(sandbox_mgmt_active_sandboxes{template=~\"$template\"}) or vector(0)",
          "legendFormat": "active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "value": null, "color": "green" },
              { "value": 5, "color": "yellow" },
              { "value": 10, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "title": "Active by Template",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sandbox_mgmt_active_sandboxes{template=~\"$template\"}",
          "legendFormat": "{{ template }}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "title": "Spawn Rate",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(sandbox_mgmt_spawns_total{template=~\"$template\"}[5m])) * 60",
          "legendFormat": "spawns/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm"
        }
      }
    },
    {
      "title": "Exit Rate by State",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sum by (terminal_state) (rate(sandbox_mgmt_exits_total{template=~\"$template\"}[5m])) * 60",
          "legendFormat": "{{ terminal_state }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm"
        }
      }
    },
    {
      "title": "Spawns / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sum by (template) (rate(sandbox_mgmt_spawns_total{template=~\"$template\"}[1m])) * 60",
          "legendFormat": "{{ template }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm",
          "custom": { "fillOpacity": 20 }
        }
      }
    },
    {
      "title": "Exits / min by State",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sum by (terminal_state) (rate(sandbox_mgmt_exits_total{template=~\"$template\"}[1m])) * 60",
          "legendFormat": "{{ terminal_state }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm",
          "custom": { "fillOpacity": 20 }
        }
      }
    },
    {
      "title": "Active Sandboxes Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sum by (template) (sandbox_mgmt_active_sandboxes{template=~\"$template\"})",
          "legendFormat": "{{ template }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 30 }
        }
      }
    },
    {
      "title": "Spawn Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(sandbox_mgmt_spawn_duration_seconds_bucket{template=~\"$template\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sandbox_mgmt_spawn_duration_seconds_bucket{template=~\"$template\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(sandbox_mgmt_spawn_duration_seconds_bucket{template=~\"$template\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Sandbox Lifetime",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(sandbox_mgmt_sandbox_lifetime_seconds_bucket{template=~\"$template\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sandbox_mgmt_sandbox_lifetime_seconds_bucket{template=~\"$template\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Sandbox Lifetime Heatmap",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(sandbox_mgmt_sandbox_lifetime_seconds_bucket{template=~\"$template\"}[1m])) by (le)",
          "legendFormat": "{{ le }}",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": { "unit": "s" },
        "color": { "scheme": "Oranges" }
      }
    },
    {
      "title": "Spawn Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(sandbox_mgmt_spawn_errors_total{template=~\"$template\"}[5m])) * 60",
          "legendFormat": "spawn errors/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "fillOpacity": 20 }
        }
      }
    },
    {
      "title": "OOM Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 22 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(sandbox_mgmt_exits_total{template=~\"$template\",oom=\"true\"}[5m])) * 60",
          "legendFormat": "OOM/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm",
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "custom": { "fillOpacity": 20 }
        }
      }
    },
    {
      "title": "Kill Rate by Reason",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 22 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sum by (reason) (rate(sandbox_mgmt_kills_total{template=~\"$template\"}[5m])) * 60",
          "legendFormat": "{{ reason }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm",
          "custom": { "fillOpacity": 20 }
        }
      }
    },
    {
      "title": "Cgroup Assign Failures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 22 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(sandbox_mgmt_cgroup_assign_failures_total{template=~\"$template\"}[5m])) * 60",
          "legendFormat": "failures/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "fillOpacity": 20 }
        }
      }
    }
  ],
  "schemaVersion": 39
}
