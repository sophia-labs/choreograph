{
	"name": "choreograph-workspace",
	"private": true,
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@10.34.5",
	"scripts": {
		"build": "pnpm --filter @sophia-labs/canonical-json build && tsc -b src/browser-service/tsconfig.json && tsc -p tsconfig.acp.json",
		"check": "pnpm --filter @sophia-labs/canonical-json build && pnpm exec biome check src packages/canonical-json packages/agent-body && pnpm exec tsc -b --pretty false",
		"check:types": "node scripts/check-types.mjs",
		"dev:local-native": "CHOREOGRAPH_SANDBOX_MODE=local-native DATA_DIR=.data/local-native tsx src/orchestrator.ts",
		"test": "pnpm --filter @sophia-labs/canonical-json build && pnpm --filter @sophia-labs/canonical-json test && pnpm --filter @sophia-labs/choreograph-agent-body test && tsx --test src/test/*.test.ts",
		"test:linux": "pnpm --filter @sophia-labs/canonical-json build && pnpm --filter @sophia-labs/canonical-json test && pnpm --filter @sophia-labs/choreograph-agent-body test && tsx --test --test-concurrency=1 src/test/*.test.ts",
		"dev:vm": "scripts/vm/dev.sh",
		"vm:up": "scripts/vm/up.sh",
		"vm:shell": "scripts/vm/shell.sh",
		"vm:sync": "scripts/vm/sync.sh",
		"vm:chat": "tsx scripts/vm/chat.ts",
		"vm:down": "scripts/vm/down.sh",
		"test:vm": "scripts/vm/run.sh scripts/test-linux-delegated.sh",
		"build:gardend-service": "node deploy/build-gardend-service.mjs"
	},
	"dependencies": {
		"@aws-sdk/client-ssm": "3.1048.0",
		"@sophia-labs/canonical-json": "workspace:*",
		"@earendil-works/pi-agent-core": "0.79.7",
		"@earendil-works/pi-ai": "0.79.7",
		"@libsql/client": "^0.17.3",
		"@modelcontextprotocol/sdk": "^1.28.0",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.57.2",
		"@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
		"@opentelemetry/instrumentation-http": "^0.57.2",
		"@opentelemetry/resources": "^1.30.1",
		"@opentelemetry/sdk-metrics": "^1.30.1",
		"@opentelemetry/sdk-node": "^0.57.2",
		"@opentelemetry/sdk-trace-base": "^1.30.1",
		"@opentelemetry/semantic-conventions": "^1.40.0",
		"ajv": "^8.18.0",
		"aws-jwt-verify": "^5.2.1",
		"json5": "^2.2.3",
		"pixelmatch": "^7.2.0",
		"playwright": "^1.50.0",
		"pngjs": "^7.0.0",
		"tsx": "^4.20.3",
		"ws": "8.18.3",
		"y-websocket": "2.1.0",
		"yjs": "13.6.27"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "^24.3.0",
		"@types/pngjs": "^6.0.5",
		"@types/ws": "8.18.1",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"esbuild": "0.28.2",
		"oxigraph": "0.5.9",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=22.13.0"
	}
}
