# Local-dev orchestrator environment (copied to /etc/choreograph/dev.env on first
# provision). Every value has a working default in run-orchestrator.sh — this file
# is only for overrides. Uncomment what you need, then: systemctl restart choreograph-dev
#
# ── Zero-cloud default ──────────────────────────────────────────────────────
# Out of the box the orchestrator runs with mock models (model "mock:done" /
# "mock:text", no API key) and Mnemosyne disabled. Nothing below is required.
#
# ── Real LLM (OpenRouter) ───────────────────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=google/gemini-2.5-flash
#
# ── Mnemosyne knowledge-graph tools ─────────────────────────────────────────
# Local MCP subprocess inside the sandbox (needs neem-mcp-server on the VM):
# MNEMOSYNE_TOOL_TRANSPORT=local-mcp-stdio
# MNEMOSYNE_GRAPH_ID=choreograph-2
#
# ── Observability (OTEL/Grafana) ────────────────────────────────────────────
# Disabled by default. To export traces/metrics, run deploy/observability/
# docker-compose.yml in the VM, then:
# OTEL_SDK_DISABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
